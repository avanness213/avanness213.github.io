---
import '@fontsource-variable/outfit';
import { Icon } from 'astro-icon/components';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Alexander Van Ness — Patient success and customer success professional with 15+ years of hands-on healthcare experience. Remote-first, Cleveland, Ohio." />
    <title>Alexander Van Ness</title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
  </head>

  <body>

    <!-- ───── HERO ───── -->
    <header class="hero">
      <img
        src="/images/triptych.png"
        alt=""
        class="hero-portrait"
        data-parallax="0.16"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <div class="hero-rail hero-rail--one" data-parallax="-0.08" aria-hidden="true"></div>
      <div class="hero-rail hero-rail--two" data-parallax="0.22" aria-hidden="true"></div>
      <div class="hero-inner" data-parallax="-0.04">
        <div class="hero-kicker">
          <span>Patient Success</span>
          <span>Customer Success</span>
          <span>Remote · Cleveland, OH</span>
        </div>
        <h1 class="hero-name">
          <span class="name-line">Alexander</span>
          <span class="name-line">Van Ness</span>
        </h1>
        <p class="tagline">
          Fifteen years of hands-on healthcare taught me how to earn someone's trust in the first
          five minutes and keep it for a decade. I'm bringing that to patient success and customer
          success in healthcare technology — remote-first, people-first.
        </p>
        <nav class="hero-actions" aria-label="Primary links">
          <a class="action action--primary" href="/AlexanderVanNessResume.pdf" download>Resume</a>
          <a class="action" href="mailto:Avanness213@gmail.com"><Icon name="lucide:mail" class="action-icon" />Email</a>
          <a class="action" href="https://www.linkedin.com/in/alexander-van-ness" target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:linkedin" class="action-icon" />LinkedIn</a>
          <a class="action" href="https://www.instagram.com/lifelongbodywork/" target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:instagram" class="action-icon" />Instagram</a>
          <a class="action" href="https://www.lifelongbodywork.com/" target="_blank" rel="noopener noreferrer">Lifelong Bodywork</a>
        </nav>
      </div>
      <div class="hero-panel" data-parallax="-0.12" aria-hidden="true">
        <span class="panel-label">Open To</span>
        <span class="panel-title">Remote Patient &amp; Customer Success</span>
        <span class="panel-copy">Healthcare tech, digital health, and hospital systems. Roles where long-term relationships and hard conversations are the job, not a side effect.</span>
      </div>
    </header>

    <!-- ───── STRENGTHS ───── -->
    <section class="stack-section" aria-label="Core strengths">
      <ul class="chip-list" role="list">
        <li class="chip"><Icon name="lucide:heart-handshake" class="chip-icon" />Patient Advocacy</li>
        <li class="chip"><Icon name="lucide:users" class="chip-icon" />Relationship Management</li>
        <li class="chip"><Icon name="lucide:ear" class="chip-icon" />Sensitive Conversations</li>
        <li class="chip"><Icon name="lucide:life-buoy" class="chip-icon" />Service Recovery</li>
        <li class="chip"><Icon name="lucide:repeat" class="chip-icon" />Retention &amp; Follow-Up</li>
        <li class="chip"><Icon name="lucide:calendar-check" class="chip-icon" />Appointment Coordination</li>
        <li class="chip"><Icon name="lucide:shield-check" class="chip-icon" />Confidential Information</li>
        <li class="chip"><Icon name="lucide:message-circle" class="chip-icon" />Phone · Email · Text</li>
        <li class="chip"><Icon name="lucide:laptop" class="chip-icon" />Remote Communication</li>
      </ul>
    </section>

    <!-- ───── NOW ───── -->
    <section class="section now-section" aria-labelledby="now-heading">
      <p class="eyebrow" id="now-heading">Now</p>
      <div class="now-grid" role="list">
        <div class="now-card now-card--wide" role="listitem">
          <span class="now-label">Looking For</span>
          <ul class="project-list">
            <li><span class="project-link project-link--static">Patient Success</span></li>
            <li><span class="project-link project-link--static">Patient Engagement</span></li>
            <li><span class="project-link project-link--static">Healthcare Customer Support</span></li>
            <li><span class="project-link project-link--static">Customer Success</span></li>
          </ul>
          <p class="now-copy">Remote-first. Healthcare-adjacent technology, digital health platforms, or hospital and health-system teams.</p>
        </div>
        <div class="now-card" role="listitem">
          <span class="now-label">Still Practicing</span>
          <span class="now-value">Medical &amp; sports massage at <a href="https://www.lifelongbodywork.com/" class="now-link" target="_blank" rel="noopener noreferrer">Nordic Health Massage</a></span>
        </div>
        <div class="now-card" role="listitem">
          <span class="now-label">Off The Clock</span>
          <span class="now-value">Music · Medieval martial arts · Viking reenactment</span>
        </div>
      </div>
    </section>

    <!-- ───── EXPERIENCE ───── -->
    <section class="section exp-section" aria-labelledby="exp-heading">
      <p class="eyebrow" id="exp-heading">Experience</p>
      <ol class="exp-list">

        <li class="exp-role">
          <div class="exp-header">
            <span class="exp-company">Nordic Health Massage</span>
            <span class="exp-meta">Owner · Licensed Massage Therapist · 2011 – Present · Cleveland, OH</span>
          </div>
          <ul class="exp-bullets">
            <li>Built and sustained an independent healthcare practice for 15+ years on personalized care, relationship building, and repeat-client retention — clients who came for an injury and stayed for a decade.</li>
            <li>Own the complete client experience: first inquiry, scheduling, treatment, follow-up, referrals, and ongoing care. Memberships, treatment packages, and proactive check-ins turned one-time visits into recurring relationships.</li>
            <li>Translate complex health and treatment information into plain, usable guidance while holding professional boundaries and confidentiality — for elderly patients, cancer survivors, hospice cases, and professional athletes alike.</li>
            <li>Built lasting referral relationships with athletes, trainers, martial artists, and wellness professionals; developed specialized medical, sports, injury-recovery, and combat-sports services to meet their needs.</li>
          </ul>
        </li>

        <li class="exp-role">
          <div class="exp-header">
            <span class="exp-company">Kia of Bedford</span>
            <span class="exp-meta">Sales Consultant · 2016 – 2017 · Bedford, OH</span>
          </div>
          <ul class="exp-bullets">
            <li>Converted internet and telephone leads into appointments and sales through needs-based conversation and consistent follow-up.</li>
            <li>Earned repeat and referral business by identifying what each customer actually needed, addressing concerns directly, and staying responsive after the sale.</li>
          </ul>
        </li>

        <li class="exp-role">
          <div class="exp-header">
            <span class="exp-company">Motorcars Honda</span>
            <span class="exp-meta">Sales Consultant · 2007 – 2009 · Cleveland, OH</span>
          </div>
          <ul class="exp-bullets">
            <li>Developed new customer relationships by phone, internet, and in person, consistently moving prospects toward appointments and purchases.</li>
            <li>Increased customer confidence by simplifying complex options and resolving concerns before they became objections.</li>
          </ul>
        </li>

        <li class="exp-role">
          <div class="exp-header">
            <span class="exp-company">BD's Mongolian Grill</span>
            <span class="exp-meta">Grill Captain · Team Leader · 1999 – 2006 · Cleveland, OH</span>
          </div>
          <ul class="exp-bullets">
            <li>Hired, trained, and developed employees while keeping customer satisfaction, product quality, and daily operations on track.</li>
            <li>Built the communication toolkit — body language, tone, conversational control — that every role since has been built on.</li>
          </ul>
        </li>

      </ol>
    </section>

    <!-- ───── BACKGROUND ───── -->
    <section class="triptych-section" aria-label="Background">
      <div class="triptych-wrap">
        <p class="background-tagline">From the treatment table to the stage to the shield wall.</p>
        <div class="triptych-narrative">
          <p>The bodywork chapter is where I learned what care actually looks like. I trained in the Boswell Technique, a gentle approach my mother, Donna Boswell, developed for people who can't tolerate force: elderly patients, cancer survivors, hospice cases, acute injuries. The most important thing on the table isn't your hands. It's whether the person trusts you enough to tell you the truth about how they feel.</p>
          <p>Music gave me the other half. Performing for a living means reading a room in real time, adjusting on the fly, and making a group of people feel like the night was built for them. It's also where I first learned what an injury does to a life — mine — and why "return to normal quickly and safely" became the standard I hold for everyone I work with.</p>
          <p>The Norse side is community. As a Viking reenactor and Asatru gothi, I hold space for people at their most human: celebrations, losses, the moments that need someone steady in the room. That's the same skill a patient needs when the diagnosis is scary or the bill doesn't make sense.</p>
          <p>Patient success is where all three meet: understand the person in front of you, explain the complicated thing plainly, stay with them until it's resolved, and be the reason they come back. I've been doing that one client at a time for fifteen years. I'd like to do it at scale.</p>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <p>&copy; 2026 Alexander Van Ness</p>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const parallaxItems = Array.from(document.querySelectorAll('[data-parallax]'));

      function updateParallax() {
        if (reduceMotion.matches) return;

        const scrollY = window.scrollY;
        for (const item of parallaxItems) {
          const speed = Number(item.dataset.parallax || 0);
          item.style.setProperty('--parallax-y', `${scrollY * speed}px`);
        }
      }

      updateParallax();
      window.addEventListener('scroll', () => requestAnimationFrame(updateParallax), { passive: true });
    </script>

  </body>
</html>

<style>
  :root {
    --ink: #101416;
    --paper: #f3efe6;
    --paper-strong: #fbf8f1;
    --night: #0a1620;
    --night-2: #10262c;
    --glacier: #6cc4c6;
    --glacier-dark: #23787a;
    --copper: #d6844a;
    --amber: #e9b95a;
    --moss: #7fa860;
    --muted: #667275;
    --line: rgba(16, 20, 22, 0.16);
    --light-line: rgba(251, 248, 241, 0.18);
    --shadow: 0 26px 70px rgba(10, 22, 32, 0.18);

    --text-xs: 0.75rem;
    --text-sm: 0.9rem;
    --text-base: 1rem;
    --text-lg: 1.22rem;
    --text-xl: 1.55rem;
    --text-hero: 4.2rem;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background: var(--night);
  }

  body {
    font-family: 'Outfit Variable', 'Outfit', system-ui, sans-serif;
    font-size: var(--text-base);
    color: var(--ink);
    background:
      linear-gradient(180deg, rgba(10, 22, 32, 0) 0, rgba(10, 22, 32, 0) 82svh, var(--paper) 82svh),
      url('/images/hero-bg.png') center top / cover fixed;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  .eyebrow {
    color: var(--glacier-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    min-height: 88svh;
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    padding: 4.5rem 1.25rem 2rem;
    overflow: hidden;
    color: var(--paper-strong);
    background: var(--night);
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero::before {
    background:
      linear-gradient(90deg, rgba(10, 22, 32, 0.96) 0%, rgba(10, 22, 32, 0.9) 34%, rgba(10, 22, 32, 0.42) 62%, rgba(10, 22, 32, 0.22) 100%),
      linear-gradient(0deg, rgba(10, 22, 32, 0.9) 0%, rgba(10, 22, 32, 0.04) 48%, rgba(10, 22, 32, 0.34) 100%);
  }

  .hero::after {
    opacity: 0.32;
    background:
      linear-gradient(120deg, transparent 0 28%, rgba(108, 196, 198, 0.32) 28% 29%, transparent 29% 52%, rgba(214, 132, 74, 0.36) 52% 53%, transparent 53%),
      repeating-linear-gradient(90deg, rgba(251, 248, 241, 0.12) 0 1px, transparent 1px 96px);
    mix-blend-mode: screen;
  }

  .hero-portrait {
    position: absolute;
    inset: -8%;
    z-index: 0;
    width: 116%;
    height: 116%;
    object-fit: cover;
    object-position: 76% center;
    opacity: 0.9;
    filter: saturate(1.18) contrast(1.1) brightness(1.06);
    transform: translate3d(0, var(--parallax-y, 0), 0) scale(1.02);
    will-change: transform;
  }

  .hero-rail {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    transform: translate3d(0, var(--parallax-y, 0), 0) rotate(-18deg);
    will-change: transform;
  }

  .hero-rail--one {
    width: 11rem;
    height: 62svh;
    right: 19%;
    bottom: -11svh;
    border-left: 1px solid rgba(108, 196, 198, 0.5);
    border-right: 1px solid rgba(233, 185, 90, 0.36);
    background: linear-gradient(180deg, rgba(108, 196, 198, 0.18), rgba(214, 132, 74, 0.08));
  }

  .hero-rail--two {
    width: 7rem;
    height: 38svh;
    right: 6%;
    top: 12svh;
    border-left: 1px solid rgba(214, 132, 74, 0.48);
    background: linear-gradient(180deg, rgba(214, 132, 74, 0.22), transparent);
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    width: min(100%, 1120px);
    margin-inline: auto;
    transform: translate3d(0, var(--parallax-y, 0), 0);
    will-change: transform;
  }

  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.4rem;
  }

  .hero-kicker span {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--light-line);
    border-radius: 999px;
    padding: 0.42rem 0.8rem;
    color: rgba(251, 248, 241, 0.88);
    background: rgba(10, 22, 32, 0.36);
    backdrop-filter: blur(12px);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    max-width: 12ch;
    margin-bottom: 1.35rem;
    color: var(--paper-strong);
    font-size: var(--text-hero);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.92;
    text-shadow: 0 18px 52px rgba(0, 0, 0, 0.42);
  }

  .name-line {
    display: block;
  }

  .tagline {
    max-width: 710px;
    color: rgba(251, 248, 241, 0.84);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.7rem;
  }

  .action {
    min-height: 2.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 999px;
    padding: 0.72rem 1rem;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
    border: 1px solid var(--light-line);
    color: var(--paper-strong);
    background: rgba(251, 248, 241, 0.08);
    backdrop-filter: blur(14px);
  }

  .action--primary {
    border-color: transparent;
    color: var(--night);
    background: linear-gradient(135deg, var(--amber), var(--copper));
  }

  .action:hover,
  .action:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  .action:focus-visible,
  .now-link:focus-visible,
  .narrative-link:focus-visible {
    box-shadow: 0 0 0 3px rgba(108, 196, 198, 0.34);
  }

  .action-icon,
  .chip-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .hero-panel {
    width: min(19rem, calc(100% - 2.5rem));
    position: absolute;
    z-index: 3;
    right: 1.25rem;
    bottom: 1.5rem;
    display: none;
    border: 1px solid var(--light-line);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(10, 22, 32, 0.68);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow);
    transform: translate3d(0, var(--parallax-y, 0), 0);
    will-change: transform;
  }

  .panel-label,
  .panel-copy {
    display: block;
    color: rgba(251, 248, 241, 0.62);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .panel-label {
    color: var(--amber);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .panel-title {
    display: block;
    margin: 0.35rem 0;
    color: var(--paper-strong);
    font-size: var(--text-lg);
    font-weight: 900;
    line-height: 1.1;
  }

  .section,
  .stack-section,
  .triptych-section,
  .site-footer {
    padding-inline: 1.25rem;
  }

  .section {
    padding-block: 3.5rem;
  }

  .section > .eyebrow {
    width: min(100%, 1120px);
    margin: 0 auto 1.4rem;
  }

  .stack-section {
    position: relative;
    z-index: 1;
    padding-block: 1.1rem;
    color: var(--paper-strong);
    background: linear-gradient(90deg, var(--night), #123236 52%, #3a2418);
    border-block: 1px solid rgba(251, 248, 241, 0.1);
  }

  .chip-list {
    width: min(100%, 1120px);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    min-height: 2.15rem;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(251, 248, 241, 0.18);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    color: rgba(251, 248, 241, 0.84);
    background: rgba(251, 248, 241, 0.06);
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .chip-icon {
    color: var(--glacier);
  }

  .now-section {
    color: var(--paper-strong);
    background:
      linear-gradient(180deg, #0b1a22 0%, #10242a 52%, var(--night) 100%),
      url('/images/hero-bg.png') center / cover;
  }

  .now-section .eyebrow {
    color: var(--amber);
  }

  .now-grid,
  .exp-list {
    width: min(100%, 1120px);
    margin-inline: auto;
  }

  .now-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .now-card {
    position: relative;
    display: flex;
    min-height: 7rem;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--light-line);
    border-radius: 8px;
    padding: 1.25rem;
    background: rgba(251, 248, 241, 0.06);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(14px);
  }

  .now-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-top: 5px solid var(--glacier);
    pointer-events: none;
  }

  .now-card:nth-child(2)::before {
    border-top-color: var(--copper);
  }

  .now-card:nth-child(3)::before {
    border-top-color: var(--moss);
  }

  .now-label {
    color: rgba(251, 248, 241, 0.58);
    font-size: var(--text-xs);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .now-value {
    color: var(--paper-strong);
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1.2;
  }

  .now-copy {
    color: rgba(251, 248, 241, 0.7);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .now-link {
    color: var(--glacier);
    text-decoration: underline;
    text-decoration-color: rgba(108, 196, 198, 0.45);
    text-underline-offset: 3px;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    list-style: none;
  }

  .project-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.35rem;
    color: var(--glacier);
    font-size: var(--text-lg);
    font-weight: 900;
    line-height: 1.2;
    text-decoration: none;
  }

  .project-link--static::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--copper);
  }

  .exp-section {
    color: var(--paper-strong);
    background:
      linear-gradient(180deg, rgba(10, 22, 32, 0.95), rgba(16, 38, 44, 0.97)),
      url('/images/hero-bg.png') center / cover;
  }

  .exp-section .eyebrow {
    color: var(--amber);
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    counter-reset: roles;
  }

  .exp-role {
    counter-increment: roles;
    display: grid;
    gap: 1rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--light-line);
  }

  .exp-role:last-child {
    border-bottom: 1px solid var(--light-line);
  }

  .exp-header {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .exp-header::before {
    content: '0' counter(roles);
    color: var(--copper);
    font-size: var(--text-sm);
    font-weight: 900;
  }

  .exp-company {
    color: var(--paper-strong);
    font-size: var(--text-xl);
    font-weight: 900;
    line-height: 1;
  }

  .exp-meta {
    color: rgba(251, 248, 241, 0.58);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .exp-bullets {
    display: grid;
    gap: 0.8rem;
    list-style: none;
  }

  .exp-bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: rgba(251, 248, 241, 0.78);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .exp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--glacier);
    box-shadow: 0 0 0 4px rgba(108, 196, 198, 0.14);
